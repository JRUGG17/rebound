# Copy to .env in this folder, or place a .env one folder above this repo.
# The app searches this folder first, then every parent folder (nearest wins).

# Required. The course key.
PORTKEY_API_KEY=your-portkey-key-here

# Optional. Defaults are correct for the course key — you should not need to set these.
MODEL_NAME=gpt-6-luna
PORTKEY_BASE_URL=https://api.portkey.ai/v1
